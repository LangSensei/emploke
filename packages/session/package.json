{
  "name": "@emploke/session",
  "version": "0.0.1",
  "description": "Per-session workdir registry for emploke (manages CLI sessions baked from a catalog, parameterised over a Runtime)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/logger": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@mikro-orm/better-sqlite": "^6.6.0",
    "@mikro-orm/core": "^6.6.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@mikro-orm/migrations": "^6.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/session"
  }
}
