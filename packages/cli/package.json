{
  "name": "@emploke/cli",
  "version": "0.0.1",
  "description": "Command-line interface for emploke (lifecycle commands + HTTP API client)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/fs": "workspace:*",
    "@emploke/paths": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@emploke/server": "workspace:*",
    "@emploke/session": "workspace:*",
    "@emploke/task": "workspace:*",
    "@emploke/workspace": "workspace:*",
    "commander": "^12.1.0",
    "inversify": "^7.0.0",
    "mediatr-ts": "^2.2.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/cli"
  }
}
