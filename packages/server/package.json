{
  "name": "@emploke/server",
  "version": "0.0.1",
  "type": "module",
  "_devPortNote": "The PORT=41817 in scripts.dev MUST stay in lock-step with the proxy target in packages/dashboard/vite.config.ts. If they drift, dev /api/* requests silently ECONNREFUSED.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "cross-env PORT=41817 node --watch --import tsx src/bin.ts --no-serve-static",
    "build": "tsc",
    "start": "node dist/index.js --serve-static",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/catalog-fetcher": "workspace:*",
    "@emploke/logger": "workspace:*",
    "@emploke/paths": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@emploke/session": "workspace:*",
    "@emploke/task": "workspace:*",
    "@emploke/terminal": "workspace:*",
    "@emploke/workspace": "workspace:*",
    "@hono/node-server": "^1.14.1",
    "@mikro-orm/core": "^6.6.0",
    "@mikro-orm/migrations": "^6.6.0",
    "@mikro-orm/better-sqlite": "^6.6.0",
    "hono": "^4.7.11",
    "inversify": "^7.0.0",
    "mediatr-ts": "^2.2.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
