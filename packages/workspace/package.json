{
  "name": "@emploke/workspace",
  "version": "0.0.1",
  "description": "Workspace abstraction for emploke — per-project root directory holding sessions/ + tasks/ + workspace.db, plus a $EMPLOKE_HOME-level registry",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "mikro-orm.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "orm:migration:create": "mikro-orm migration:create",
    "orm:migration:up": "mikro-orm migration:up",
    "orm:schema:fresh": "mikro-orm schema:fresh --run"
  },
  "dependencies": {
    "@emploke/fs": "workspace:*",
    "@emploke/logger": "workspace:*",
    "@emploke/paths": "workspace:*",
    "@mikro-orm/core": "^6.6.0",
    "@mikro-orm/better-sqlite": "^6.6.0",
    "inversify": "^7.0.0",
    "mediatr-ts": "^2.2.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@mikro-orm/migrations": "^6.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/workspace"
  }
}
