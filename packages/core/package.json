{
  "name": "@emploke/core",
  "version": "0.0.1",
  "description": "Orchestration root for emploke: composes workspace + session + task + catalog + runtime into a per-workspace runtime context",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/logger": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@emploke/session": "workspace:*",
    "@emploke/task": "workspace:*",
    "@emploke/workspace": "workspace:*",
    "@mikro-orm/better-sqlite": "^6.6.0",
    "@mikro-orm/core": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/core"
  }
}
