{
  "name": "@emploke/api-types",
  "version": "0.0.1",
  "description": "Out-of-band IPC contracts shared by emploke server + CLI: EMPLOKE_HOME resolution, runtime.json shape, HTTP route manifest, and wire types.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@emploke/schedule": "workspace:*",
    "@emploke/session": "workspace:*",
    "@emploke/task": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/api-types"
  }
}
