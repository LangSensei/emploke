{
  "name": "@emploke/contracts",
  "version": "0.0.1",
  "description": "Wire contracts and leaf path helpers for emploke. The strict-isolation entrypoint for dashboard + CLI: pure types plus pure-function path helpers, with no orchestration code in the runtime graph.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@emploke/catalog": "workspace:*",
    "@emploke/runtime": "workspace:*",
    "@emploke/schedule": "workspace:*",
    "@emploke/session": "workspace:*",
    "@emploke/task": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LangSensei/emploke.git",
    "directory": "packages/contracts"
  }
}
